#!/usr/bin/env bash
# USB-only Android display and control launcher for Linux.
set -u

readonly SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

readonly WAIT_SECONDS="${GALAXY_WAIT_SECONDS:-15}"
readonly PROJECTION_WAIT_SECONDS="${GALAXY_PROJECTION_WAIT_SECONDS:-120}"
readonly DEFAULT_BITRATE="${GALAXY_BITRATE:-16M}"
readonly DEFAULT_MAX_SIZE="${GALAXY_MAX_SIZE:-1920}"
readonly DEFAULT_MAX_FPS="${GALAXY_MAX_FPS:-60}"
readonly KEYBOARD_MODE="${GALAXY_KEYBOARD:-uhid}"
readonly MOUSE_MODE="${GALAXY_MOUSE:-uhid}"

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Galaxy USB" "$1" "${2:-}" >/dev/null 2>&1 || true
  fi
}

fail() {
  printf 'Galaxy USB: %s\n' "$1" >&2
  notify "Galaxy USB" "$1"
  exit 1
}

usage() {
  cat <<'EOF'
Usage: galaxy-usb [mirror|desktop|projection|list]

  mirror   Mirror the Android main display and control it with the PC (default)
  desktop  Create a landscape virtual display for a desktop-like session
  projection  View a MediaProjection stream over USB without USB debugging
  list     Show ADB devices (the launcher accepts USB devices only)
EOF
}

mode="${1:-mirror}"
case "$mode" in
  mirror|desktop|projection|list) ;;
  -h|--help|help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

if [[ "$mode" == "projection" ]]; then
  # The receiver performs the AOA handshake and owns the ffplay process. It
  # deliberately has no ADB dependency; INFO supplies ffplay's input rate.
  receiver_candidates=()
  if [[ -n "${GALAXY_PROJECTION_RECEIVER:-}" ]]; then
    receiver_candidates+=("$GALAXY_PROJECTION_RECEIVER")
  fi
  receiver_candidates+=(
    "$SCRIPT_DIR/receiver/gusb-receiver"
    "$SCRIPT_DIR/receiver/galaxy-usb-receiver"
    "$SCRIPT_DIR/receiver/galaxy-usb-aoa"
    "$HOME/.local/libexec/gusb-receiver"
    "$HOME/.local/libexec/galaxy-usb-receiver"
    "$HOME/.local/libexec/galaxy-usb-aoa"
    "$HOME/.local/bin/gusb-receiver"
    "$HOME/.local/bin/galaxy-usb-receiver"
    "$HOME/.local/bin/galaxy-usb-aoa"
  )

  receiver=""
  for candidate in "${receiver_candidates[@]}"; do
    if [[ -x "$candidate" ]]; then
      receiver="$candidate"
      break
    fi
  done
  if [[ -z "$receiver" ]]; then
    if command -v gusb-receiver >/dev/null 2>&1; then
      receiver="$(command -v gusb-receiver)"
    elif command -v galaxy-usb-receiver >/dev/null 2>&1; then
      receiver="$(command -v galaxy-usb-receiver)"
    elif command -v galaxy-usb-aoa >/dev/null 2>&1; then
      receiver="$(command -v galaxy-usb-aoa)"
    fi
  fi
  [[ -n "$receiver" ]] || fail "MediaProjection受信プログラムが見つかりません。receiver/README.md のビルドとインストールを確認してください。"

  notify "Galaxy USB" "MediaProjectionのUSB表示を起動しています。USBデバッグは不要です。"
  receiver_args=(
    --wait "$PROJECTION_WAIT_SECONDS"
    --hello-timeout "$PROJECTION_WAIT_SECONDS"
    --window-title "Mirror (MediaProjection) - Galaxy USB"
  )
  if [[ -n "${GALAXY_PROJECTION_DEVICE:-}" ]]; then
    receiver_args+=(--device "$GALAXY_PROJECTION_DEVICE")
  fi
  "$receiver" "${receiver_args[@]}"
  receiver_status="$?"
  if (( receiver_status != 0 )); then
    printf 'Galaxy USB: MediaProjection受信部が終了しました (status %s)。USB接続、AOA許可、Androidの画面共有同意を確認してください。\n' \
      "$receiver_status" >&2
    notify "Galaxy USB" "MediaProjection受信部が終了しました。USB接続とAndroidの許可を確認してください。"
    exit "$receiver_status"
  fi
  exit 0
fi

command -v adb >/dev/null 2>&1 || fail "adb が見つかりません。Android platform tools を確認してください。"
command -v scrcpy >/dev/null 2>&1 || fail "scrcpy が見つかりません。scrcpy を確認してください。"

adb start-server >/dev/null 2>&1 || fail "ADBを起動できません。USB権限とudev設定を確認してください。"

if [[ "$mode" == "list" ]]; then
  adb devices -l
  exit $?
fi

serial="${GALAXY_ADB_SERIAL:-}"
selected_usb=false
last_unauthorized=""
for ((waited = 0; waited <= WAIT_SECONDS; waited++)); do
  devices_output="$(adb devices -l 2>/dev/null || true)"

  if [[ -n "$serial" ]]; then
    if printf '%s\n' "$devices_output" | awk -v want="$serial" '$1 == want && $2 == "unauthorized" && $0 ~ /(^|[[:space:]])usb:/ {found=1} END {exit !found}'; then
      fail "端末の「USBデバッグを許可しますか？」でこのPCを許可してください。"
    fi
    if printf '%s\n' "$devices_output" | awk -v want="$serial" '$1 == want && $2 == "device" && $0 ~ /(^|[[:space:]])usb:/ {found=1} END {exit !found}'; then
      selected_usb=true
      break
    fi
  else
    last_unauthorized="$(printf '%s\n' "$devices_output" | awk '$2 == "unauthorized" && $0 ~ /(^|[[:space:]])usb:/ {print $1}')"
    mapfile -t usb_devices < <(printf '%s\n' "$devices_output" | awk '$2 == "device" && $0 ~ /(^|[[:space:]])usb:/ {print $1}')
    if (( ${#usb_devices[@]} > 1 )); then
      fail "USB端末が複数あります。GALAXY_ADB_SERIAL=端末ID を指定してください。"
    elif (( ${#usb_devices[@]} == 1 )); then
      serial="${usb_devices[0]}"
      selected_usb=true
      break
    fi
  fi

  if (( waited < WAIT_SECONDS )); then
    sleep 1
  fi
done

if ! $selected_usb; then
  if [[ -n "$last_unauthorized" ]]; then
    fail "端末の「USBデバッグを許可しますか？」でこのPCを許可してください。"
  fi
  if [[ -n "${GALAXY_ADB_SERIAL:-}" ]]; then
    fail "指定した端末IDがUSB接続の認証済み端末として見つかりません。GALAXY_ADB_SERIALを確認してください。"
  fi
  fail "認証済みのUSB接続Android端末が見つかりません。データ通信対応USBケーブルで接続し、USBデバッグを有効にしてください。"
fi

model="$(adb -s "$serial" shell getprop ro.product.model 2>/dev/null | tr -d '\r' | head -n 1 || true)"
[[ -n "$model" ]] || model="Android device"

common_args=(
  "--serial=$serial"
  "--video-codec=h264"
  "--video-bit-rate=$DEFAULT_BITRATE"
  "--max-fps=$DEFAULT_MAX_FPS"
  "--video-buffer=0"
  "--keyboard=$KEYBOARD_MODE"
  "--mouse=$MOUSE_MODE"
  "--keep-active"
)

if [[ "$mode" == "mirror" ]]; then
  notify "Galaxy USB" "$model のリアルタイム表示を起動しています。"
  exec scrcpy "${common_args[@]}" "--max-size=$DEFAULT_MAX_SIZE" '--window-title=Mirror (ADB) - Galaxy USB'
fi

# A compatible Android System UI or launcher may provide desktop-like
# decorations on the virtual display. An app package can be supplied explicitly.
desktop_size="${GALAXY_DESKTOP_SIZE:-1920x1080/320}"
desktop_app="${GALAXY_DESKTOP_APP-none}"
desktop_args=(
  "${common_args[@]}"
  "--new-display=$desktop_size"
  "--flex-display"
  "--no-vd-destroy-content"
  "--display-ime-policy=local"
  '--window-title=Desktop (ADB) - Galaxy USB'
)

if [[ -n "$desktop_app" && "$desktop_app" != "none" ]] && adb -s "$serial" shell pm path "$desktop_app" >/dev/null 2>&1; then
  desktop_args+=("--start-app=$desktop_app")
fi

notify "Galaxy USB" "$model の仮想デスクトップを起動しています。"
exec scrcpy "${desktop_args[@]}"
